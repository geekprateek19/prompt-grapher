{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@prompt-grapher/shared": [
        "packages/shared/src/index.ts"
      ],
      "@prompt-grapher/core": [
        "packages/core/src/index.ts"
      ]
    }
  }
}
